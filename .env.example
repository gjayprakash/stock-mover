MESH_API_KEY=rsk_your_key_here
MESH_MODEL=openai/gpt-4o
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Shared secret for POST /api/run (X-Cron-Secret header). Same value in the GitHub Actions secret.
CRON_SECRET=dev
# MESH_BASE_URL=http://localhost:4000/v1  # local manual checks only (fake server)
# Optional sign-in. Leave APP_USERS unset/empty and the site stays open (today's behaviour).
# Format: email:bcryptHash,email:bcryptHash  (hash: node apps/api/scripts/hash-password.js 'password')
# APP_USERS=you@example.com:$2b$10$...
# Optional cookie-signing secret; defaults to a hash of APP_USERS + DATABASE_URL.
# AUTH_SECRET=some-long-random-string
